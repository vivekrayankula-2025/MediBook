# MediBook Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas) ---
# Replace <db_username>, <db_password> and <cluster> with your own values from Atlas
# (Atlas > Connect > Drivers). If the password has special characters (@ : / ? # %), URL-encode them.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/medibook?retryWrites=true&w=majority&appName=medibook
# Local MongoDB alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/medibook

# JWT Authentication Secrets
JWT_SECRET=medibook_super_secret_jwt_key_2026_final_year_project_secure
JWT_EXPIRE=7d

# SMS Gateway Configuration
# Options: mock | twilio | msg91 | fast2sms
SMS_PROVIDER=mock

# Twilio SMS Credentials (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678901

# Fast2SMS (India) - Required if SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# MSG91 SMS Credentials (Required if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=MDBOOK
MSG91_ROUTE=4
MSG91_DLT_TE_ID=your_dlt_template_id_here

# Hospital / System Branding Details for SMS
HOSPITAL_NAME=MediBook Central Hospital
HOSPITAL_HELPLINE=+1-800-555-0199

# Cron Job Schedules
# Reminders: Every hour checks for upcoming appointments within next 24 hours
REMINDER_CRON_SCHEDULE=0 * * * *
# Retry Failed SMS: Every 10 minutes
SMS_RETRY_CRON_SCHEDULE=*/10 * * * *
