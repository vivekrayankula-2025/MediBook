PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# --- Database (MongoDB Atlas) ---
# Replace <db_username>, <db_password> and <cluster> with your own values from Atlas
# (Atlas > Connect > Drivers). If the password has special characters (@ : / ? # %), URL-encode them.
MONGODB_URL
# Local MongoDB alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/medibook
JWT_SECRET=medibook_super_secret_jwt_key_2026_final_year_project_secure
JWT_EXPIRE=7d

# SMS Provider: 'mock' ensures it works 100% out of the box with realistic SMS delivery tracking & audit logs
# Change to 'twilio' or 'msg91' when real credentials are provided
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=smo

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

MSG91_AUTH_KEY=demo_msg91_key
MSG91_SENDER_ID=MDBOOK
MSG91_ROUTE=4
MSG91_DLT_TE_ID=demo_dlt_template

HOSPITAL_NAME=MediBook Central Hospital
HOSPITAL_HELPLINE=+91 

REMINDER_CRON_SCHEDULE=0 * * * *
SMS_RETRY_CRON_SCHEDULE=*/10 * * * *
